# Long random string that signs login cookies and links: openssl rand -hex 32
SESSION_SECRET=
# Public URL of the site, e.g. https://ratsignal.com (used in emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=

# Stripe: product "RatSignal Pro" with two monthly prices
STRIPE_SECRET_KEY=
STRIPE_PRICE_BASE=        # $99/month
STRIPE_PRICE_ZIP_LOCK=    # $49/month (quantity = number of locked zips)
STRIPE_WEBHOOK_SECRET=    # from the webhook endpoint you create for /api/stripe/webhook

# Upstash Redis (Vercel Marketplace sets these automatically; KV_REST_API_* names also work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend: login links and the 7am lead email. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="RatSignal <alerts@yourdomain.com>"

# Anthropic: AI call scripts / emails / letters
ANTHROPIC_API_KEY=

# Protects the daily email job. Vercel sends it automatically to cron routes.
CRON_SECRET=

# Optional: free Socrata app token for higher open-data rate limits (data.cityofnewyork.us → Developer settings)
SOCRATA_APP_TOKEN=

# Shown on privacy/terms
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
